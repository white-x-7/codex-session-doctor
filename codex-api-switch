USER_TASKS_SQL = """
SELECT id, rollout_path, model_provider, title, model
FROM threads
WHERE archived = 0
  AND (thread_source = 'user' OR thread_source IS NULL OR thread_source = '')
ORDER BY id
"""


def user_tasks(conn: sqlite3.Connection) -> list[dict]:
    rows = conn.execute(USER_TASKS_SQL).fetchall()
    return [
        {"id": r[0], "rollout_path": r[1], "provider": r[2], "title": r[3] or "", "model": r[4]}
        for r in rows
    ]


def current_provider_from_config() -> str | None:
    parsed = parse_toml(load_text(config_path()))
    return parsed.get("model_provider")


def target_default_model(target: str) -> str | None:
    """Model to relabel sessions to when syncing to ``target``."""
    if target == DEEPSEEK_PROVIDER:
        parsed = parse_toml(load_text(config_path()))
        return parsed.get("model") or DEEPSEEK_MODEL
    restore = backup_dir() / "openai-last.toml"
    if not restore.exists():
        return None
    try:
        parsed = parse_toml(restore.read_text(encoding="utf-8"))
    except Exception:  # noqa: BLE001
        return None
    return parsed.get("model") or None


def rewrite_session_model_fields(obj: dict, new_model: str, new_provider: str) -> int:
    """Rewrite model-related fields inside a parsed rollout JSON object.

    Returns how many fields changed. The rollout JSON keeps its structure;
    only the session-level model settings are rebind to the target provider so
    the desktop app stops sending the old provider's model name.
    """
    changed = 0
    payload = obj.get("payload")
    if not isinstance(payload, dict):
        return 0

    def set_model(o: dict, keys: tuple[str, ...], value: str) -> bool:
        nonlocal changed
        if isinstance(o, dict) and all(k in o for k in keys):
            if o.get(keys[-1]) != value:
                o[keys[-1]] = value
                changed += 1
            return True
        return False

    ts = payload.get("thread_settings")
    if isinstance(ts, dict):
        if set_model(ts, ("model",), new_model):
            pass
        if ts.get("model_provider_id") != new_provider:
            ts["model_provider_id"] = new_provider
            changed += 1
        collab = ts.get("collaboration_mode")
        if isinstance(collab, dict):
            s = collab.get("settings")
            if isinstance(s, dict):
                set_model(s, ("model",), new_model)

    cm = payload.get("collaboration_mode")
    if isinstance(cm, dict):
        s = cm.get("settings")
        if isinstance(s, dict):
            set_model(s, ("model",), new_model)

    state = payload.get("state")
    if isinstance(state, dict):
        set_model(state, ("model",), new_model)
        personality = state.get("personality")
        if isinstance(personality, dict):
            set_model(personality, ("model",), new_model)

    # turn_context keeps a per-turn model record; rebind it too so the app
    # never replays the old model name when resuming the thread.
    set_model(payload, ("model",), new_model)
    return changed


def rewrite_session_model_file(
    path: Path, new_model: str, new_provider: str
) -> tuple[int, int]:
    """Rewrite model-related fields in every JSON line of a rollout file.

    Returns ``(field changes, byte delta)``. Lines are padded back to their
    original byte length whenever the rewrite shrinks them, so Codex's
    byte-offset based history projection stays valid. A longer replacement
    (a longer model name) is surfaced through the byte delta instead of being
    hidden, and the caller refreshes the cached projection for that thread.
    """
    raw = path.read_bytes()
    parts = raw.split(b"\n")
    out: list[bytes] = []
    total_changed = 0
    delta = 0
    for part in parts:
        stripped = part.strip()
        if not stripped:
            out.append(part)
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            out.append(part)
            continue
        if not isinstance(obj, dict):
            out.append(part)
            continue
        changed = rewrite_session_model_fields(obj, new_model, new_provider)
        if not changed:
            out.append(part)
            continue
        carriage_return = b"\r" if part.endswith(b"\r") else b""
        body_limit = len(part) - len(carriage_return)
        line = json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        if len(line) < body_limit:
            line = pad_line(line, body_limit)
        delta += len(line) + len(carriage_return) - len(part)
        out.append(line + carriage_return)
        total_changed += changed
    new_raw = b"\n".join(out)
    if new_raw != raw:
        path.write_bytes(new_raw)
    return total_changed, delta


def plan_sync(target: str) -> dict:
    """Build a read-only plan of what a sync would change."""
    db = state_db_path()
    plan = {
        "target_provider": target,
        "state_db": str(db),
        "state_db_exists": db.exists(),
        "to_update": [],
        "skipped": [],
        "errors": [],
        "session_index_missing_ids": [],
    }
    if not db.exists():
        plan["errors"].append("state_5.sqlite not found; nothing to sync")
        return plan
    conn = connect_state_db_readonly(db)
    if conn is None:
        plan["errors"].append(
            "state_5.sqlite 暂时无法打开（Codex 可能在运行或正在升级数据库）。\n"
            "请完全退出 Codex（Cmd+Q）后重试；历史标签未同步。"
        )
        return plan
    try:
        tasks = user_tasks(conn)
    finally:
        conn.close()

    index_ids = set()
    index_path = session_index_path()
    if index_path.exists():
        for line in index_path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                index_ids.add(json.loads(line).get("id"))
            except json.JSONDecodeError:
                plan["errors"].append(f"session_index.jsonl has an unparseable line: {line[:80]}")

    for task in tasks:
        if task["provider"] == target:
            continue
        entry = {
            "id": task["id"],
            "provider": task["provider"],
            "rollout_path": task["rollout_path"],
            "model": task.get("model"),
        }
        path = Path(task["rollout_path"]) if task["rollout_path"] else None
        if path is None or not path.is_file():
            entry["reason"] = "rollout file missing"
            plan["skipped"].append(entry)
            continue
        ok, reason = validate_first_line(path, task["id"], task["provider"])
        if not ok:
            entry["reason"] = reason
            plan["skipped"].append(entry)
            continue
        plan["to_update"].append(entry)
        if task["id"] not in index_ids:
            plan["session_index_missing_ids"].append(task["id"])
    return plan


def validate_first_line(path: Path, expected_id: str, expected_provider: str) -> tuple[bool, str]:
    try:
        raw = path.read_bytes()
    except OSError as exc:
        return False, f"cannot read: {exc}"
    nl = raw.find(b"\n")
    if nl == -1:
        return False, "no newline in rollout file"
    first = raw[:nl]
    try:
        obj = json.loads(first.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        return False, "first line is not valid JSON"
    payload = obj.get("payload") if isinstance(obj, dict) else None
    if not isinstance(payload, dict):
        return False, "session_meta payload missing"
    if payload.get("id") != expected_id:
        return False, "session_meta id mismatch"
    if payload.get("model_provider") != expected_provider:
        return False, (
            f"first-line provider is {payload.get('model_provider')!r}, "
            f"expected {expected_provider!r}"
        )
    return True, ""


def new_first_line(path: Path, new_provider: str) -> str:
    raw = path.read_bytes()
    nl = raw.find(b"\n")
    first = raw[:nl].decode("utf-8")
    obj = json.loads(first)
    old = obj["payload"]["model_provider"]
    # Match the key plus the string value, regardless of spacing:
    #   "model_provider":"openai"   (compact)  or
    #   "model_provider": "openai"  (spaced)
    marker = re.compile(r'"model_provider"\s*:\s*"([^"]*)"')
    match = marker.search(first)
    if not match:
        raise ValueError("model_provider marker not found on first line")
    if match.group(1) != old:
        raise ValueError("model_provider value mismatch on first line")
    updated = first[: match.start(1)] + new_provider + first[match.end(1) :]
    parsed = json.loads(updated)
    if parsed["payload"]["model_provider"] != new_provider:
        raise ValueError("first-line rewrite did not change provider")
    # session_meta is line 1, so growing it shifts every later byte offset.
    # Pad when the new provider name is shorter so the line keeps its exact
    # length; a longer name is surfaced by the caller, which refreshes the
    # cached history projection afterwards.
    if len(updated) < len(first):
        updated += " " * (len(first) - len(updated))
    return updated


def replace_first_line_bytes(path: Path, new_first_line: str) -> None:
    raw = path.read_bytes()
    nl = raw.find(b"\n")
    if nl == -1:
        raise ValueError("rollout file has no newline")
    rest = raw[nl:]
    path.write_bytes(new_first_line.encode("utf-8") + rest)


def sync_history(target: str, dry_run: bool = False) -> dict:
    """Sync history labels to ``target``. Returns a result dict."""
    result = {
        "target_provider": target,
        "target_model": target_default_model(target),
        "dry_run": dry_run,
        "updated": 0,
        "models_relabeled": 0,
        "skipped": 0,
        "errors": [],
        "index_merged": 0,
        "backup_dir": None,
        "history_rows_dropped": 0,
    }
    db = state_db_path()
    if not db.exists():
        result["errors"].append("state_5.sqlite not found; nothing to sync")
        return result

    plan = plan_sync(target)
    result["errors"] = list(plan["errors"])
    to_update = plan["to_update"]
    skipped = plan["skipped"]
    new_model = result["target_model"]
    if new_model is None:
        result["errors"].append(
            "Cannot determine the target model (missing restore point for OpenAI); "
            "provider labels will still sync."
        )
    result["skipped"] = len(skipped)
    for entry in skipped:
        print(f"  skip  {entry['id']}: {entry.get('reason', '?')}")

    if dry_run:
        result["updated"] = len(to_update)
        if new_model:
            result["models_relabeled"] = len(to_update)
        return result

    if is_codex_running():
        result["errors"].append(
            "Codex desktop is still running. Fully quit Codex, then rerun the sync."
        )
        return result

    if not to_update:
        return result

    # ── backup ─────────────────────────────────────────────────────────────
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap = backup_dir() / f"sync-{stamp}"
    snap.mkdir(parents=True, exist_ok=True)
    result["backup_dir"] = str(snap)

    manifest: dict[str, dict] = {}
    backup_conn = connect_state_db_readonly(db)
    if backup_conn is None:
        result["errors"].append(
            "state_5.sqlite 暂时无法打开（Codex 可能在运行或正在升级数据库），历史标签未同步。\n"
            "请完全退出 Codex（Cmd+Q）后重试。"
        )
        return result
    try:
        target_bak = snap / "state_5.sqlite.bak"
        backup_target = sqlite3.connect(target_bak)
        backup_conn.backup(backup_target)
        backup_target.close()
        backup_conn.close()
    except Exception as exc:  # noqa: BLE001
        result["errors"].append(f"database backup failed: {exc}")
        return result

    for entry in to_update:
        path = Path(entry["rollout_path"])
        try:
            raw = path.read_bytes()
            nl = raw.find(b"\n")
            first_b64 = base64.b64encode(raw[:nl]).decode("ascii")
            rest_sha = hashlib.sha256(raw[nl:]).hexdigest()
        except OSError as exc:
            result["errors"].append(f"cannot read rollout for backup {entry['id']}: {exc}")
            continue
        manifest[entry["id"]] = {
            "path": str(path),
            "first_line_b64": first_b64,
            "rest_sha256": rest_sha,
            "provider": entry["provider"],
            "model": entry.get("model"),
        }
    (snap / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )

    # ── rewrite rollout first lines ────────────────────────────────────────
    rewritten: list[str] = []
    size_deltas: dict[str, int] = {}
    for entry in to_update:
        path = Path(entry["rollout_path"])
        try:
            size_before = path.stat().st_size
            updated = new_first_line(path, target)
            replace_first_line_bytes(path, updated)
            if new_model:
                rewrite_session_model_file(path, new_model, target)
            size_deltas[entry["id"]] = path.stat().st_size - size_before
            rewritten.append(entry["id"])
        except Exception as exc:  # noqa: BLE001
            result["errors"].append(f"rollout rewrite failed for {entry['id']}: {exc}")

    # ── update sqlite (only rows whose rollout was rewritten) ──────────────
    if rewritten:
        conn = None
        try:
            conn = sqlite3.connect(db)
            conn.execute("BEGIN IMMEDIATE")
            placeholders = ",".join("?" for _ in rewritten)
            if new_model:
                sql = (
                    f"UPDATE threads SET model_provider = ?, model = ? "
                    f"WHERE id IN ({placeholders})"
                )
                params: list = [target, new_model, *rewritten]
            else:
                sql = f"UPDATE threads SET model_provider = ? WHERE id IN ({placeholders})"
                params = [target, *rewritten]
            cur = conn.execute(
                sql, params
            )
            conn.commit()
            result["updated"] = cur.rowcount
            if new_model:
                result["models_relabeled"] = len(rewritten)
        except Exception as exc:  # noqa: BLE001
            if conn is not None:
                conn.rollback()
            result["errors"].append(f"database update failed: {exc}")
            # Roll back rollout first lines already rewritten
            for thread_id in rewritten:
                info = manifest.get(thread_id)
                if not info:
                    continue
                try:
                    orig = base64.b64decode(info["first_line_b64"]).decode("utf-8")
                    replace_first_line_bytes(Path(info["path"]), orig)
                except Exception:  # noqa: BLE001
                    result["errors"].append(
                        f"rollback of {thread_id} failed; restore from {snap}"
                    )
        finally:
            if conn is not None:
                conn.close()

    # ── refresh the cached history projection for rewritten rollouts ───────
    if rewritten:
        dropped, refresh_errors = refresh_history_projection(set(rewritten), snap)
        result["history_rows_dropped"] = dropped
        result["errors"].extend(refresh_errors)
        changed_sizes = {tid: delta for tid, delta in size_deltas.items() if delta}
        if changed_sizes:
            print(
                f"WARNING: {len(changed_sizes)} rollout(s) changed byte length "
                "(longer model or provider name); their cached history was "
                "refreshed so Codex re-reads them."
            )

    # ── merge missing ids into session_index.jsonl ─────────────────────────
    missing = [tid for tid in plan["session_index_missing_ids"] if tid in rewritten]
    if missing:
        index_path = session_index_path()
        lines = index_path.read_text(encoding="utf-8").splitlines() if index_path.exists() else []
        known = set()
        for line in lines:
            line = line.strip()
            if not line:
                continue
            try:
                known.add(json.loads(line).get("id"))
            except json.JSONDecodeError:
                continue
        title_map = {}
        merge_conn = connect_state_db_readonly(db)
        if merge_conn is not None:
            try:
                title_map = {t["id"]: t["title"] for t in user_tasks(merge_conn)}
            finally:
                merge_conn.close()
        added = []
        for tid in missing:
            if tid in known:
                continue
            added.append(
                json.dumps(
                    {
                        "id": tid,
                        "thread_name": title_map.get(tid) or "",
                        "updated_at": datetime.now(timezone.utc).isoformat(),
                    },
                    ensure_ascii=False,
                )
            )
        if added:
            index_path.write_text(
                "\n".join([*lines, *added]) + ("\n" if lines else ""),
                encoding="utf-8",
            )
            result["index_merged"] = len(added)

    return result


def command_sync(args: argparse.Namespace) -> int:
    target = args.target or current_provider_from_config()
    if not target:
        print("Cannot determine target provider (no --target and no config).", file=sys.stderr)
        return 2

    plan = plan_sync(target)
    print(f"Target provider: {target}")
    print(f"State db: {plan['state_db']}")
    print(f"Tasks to relabel: {len(plan['to_update'])}")
    print(f"Tasks skipped (need attention): {len(plan['skipped'])}")
    for entry in plan["skipped"]:
        print(f"  - {entry['id']} ({entry['provider']}): {entry.get('reason', '?')}")
    for error in plan["errors"]:
        print(f"ERROR: {error}", file=sys.stderr)

    if plan["errors"]:
        return 1

    if args.dry_run:
        print("Dry run: no files were changed.")
        return 0

    if plan["to_update"]:
        if is_codex_running():
            print(
                "Codex desktop is still running.\n"
                "Fully quit Codex (Cmd+Q), then run: codex-api-switch sync "
                + (f"--target {target}" if args.target else ""),
                file=sys.stderr,
            )
            return 3
        if not args.yes:
            answer = input(
                f"Relabel {len(plan['to_update'])} conversation(s) to '{target}'? [y/N] "
            ).strip().lower()
            if answer not in ("y", "yes"):
                print("Aborted.")
                return 0

    result = sync_history(target)
    print(f"Updated: {result['updated']} conversations")
    if result["models_relabeled"]:
        print(f"Models relabeled: {result['models_relabeled']} conversation(s) -> {result['target_model']}")
    if result["index_merged"]:
        print(f"session_index.jsonl: merged {result['index_merged']} missing id(s)")
    if result.get("history_rows_dropped"):
        print(
            f"History projection refreshed: {result['history_rows_dropped']} "
            "cached row(s) dropped"
        )
    if result["backup_dir"]:
        print(f"Backup: {result['backup_dir']}")
    for error in result["errors"]:
        print(f"ERROR: {error}", file=sys.stderr)
    return 1 if result["errors"] else 0


# --------------------------------------------------------------------------- #
# History repair (reasoning replay compatibility)
# --------------------------------------------------------------------------- #
#
# Sessions advanced under a third-party provider (e.g. DeepSeek) store
# plaintext reasoning content in their rollout files. When the conversation is
# resumed after switching back to the official provider, the API rejects the
# replayed history with 400 "Invalid 'input[i].content': array too long /
# array_above_max_length" because reasoning items must have an empty content
# array. The fix is to empty the content of those reasoning items.

REASONING_TYPE = "reasoning"

# Real reasoning items from the official API carry a Fernet-style
# ``encrypted_content`` blob that starts with ``gAAAAA``. Third-party
# providers and OpenAI-compatible proxies instead write a placeholder such as
# ``8ec8e468-e6a3-4513-a1f0-9fbb4f189148-0``; replaying that to the official
# API fails with "The encrypted content ... could not be verified".
OPENAI_ENCRYPTED_PREFIX = "gAAAAA"


def is_foreign_encrypted_content(value: object) -> bool:
    """True when ``encrypted_content`` cannot have come from the official API."""
    if value is None:
        return False
    if not isinstance(value, str):
        return True
    return not value.startswith(OPENAI_ENCRYPTED_PREFIX)


# Tables in ``thread_history_*.sqlite`` that cache the parsed rollout. They are
# keyed by thread id and rebuilt from the rollout file, so dropping a thread's
# rows makes Codex re-project it (and recompute its byte offsets) on next read.
HISTORY_TABLES = (
    "thread_items",
    "thread_turns",
    "thread_realtime_items",
    "thread_history_projection_state",
)


def pad_line(line: bytes, target_len: int) -> bytes:
    """Append spaces so ``line`` keeps ``target_len`` bytes.

    Trailing whitespace is insignificant in JSONL, so the line still parses
    while every downstream byte offset stays valid.
    """
    if len(line) > target_len:
        raise ValueError(
            f"cannot keep byte length: new line is {len(line)} bytes, "
            f"original was {target_len}"
        )
    return line + b" " * (target_len - len(line))


def history_db_path() -> Path | None:
    """Newest ``thread_history_*.sqlite`` in CODEX_HOME, if any."""
    candidates = sorted(codex_home().glob("thread_history_*.sqlite"))
    if not candidates:
        return None

    def version(path: Path) -> tuple[int, str]:
        match = re.search(r"thread_history_(\d+)\.sqlite$", path.name)
        return (int(match.group(1)) if match else -1, path.name)

    return max(candidates, key=version)


def backup_file_with_sidecars(path: Path, snap: Path, label: str) -> None:
    """Copy a sqlite database plus its ``-wal``/``-shm`` sidecars."""
    for suffix in ("", "-wal", "-shm"):
        source = Path(f"{path}{suffix}")
        if source.exists():
            shutil.copy2(source, snap / f"{label}{suffix}")


def rollout_thread_id(path: Path) -> str | None:
    """Session id recorded in a rollout's first line (``session_meta``)."""
    try:
        with path.open("rb") as handle:
            first = handle.readline()
        obj = json.loads(first.decode("utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    payload = obj.get("payload") if isinstance(obj, dict) else None
    if not isinstance(payload, dict):
        return None
    for key in ("session_id", "id"):
        value = payload.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def rollout_thread_ids(path: Path) -> set[str]:
    """Every thread id this rollout belongs to.

    A continued session writes ``rollout-<ts>-<sessionId>_<segmentId>.jsonl``.
    Codex keeps a separate paginated-history cursor for the session id *and*
    for each continuation segment (``thread_history_*.sqlite`` is keyed by
    those ids), so a rewrite has to refresh all of them - otherwise the
    untouched segment cursor points past the shortened file and resuming fails
    with "cutoff byte offset is past the source rollout".
    """
    ids: set[str] = set()
    session_id = rollout_thread_id(path)
    if session_id:
        ids.add(session_id)
    stem = path.name
    if stem.endswith(".jsonl"):
        stem = stem[: -len(".jsonl")]
    if "_" in stem:
        segment = stem.rsplit("_", 1)[1]
        if segment:
            ids.add(segment)
    return ids


def refresh_history_projection(
    thread_ids: set[str], snap: Path | None
) -> tuple[int, list[str]]:
    """Drop cached history rows so Codex re-reads the rewritten rollouts.

    Returns ``(deleted_rows, errors)``. Errors are reported to the caller as
    warnings: the rollout repair itself is already durable at that point.
    """
    if not thread_ids:
        return 0, []
    db = history_db_path()
    if db is None or not db.exists():
        return 0, []
    if snap is not None:
        try:
            backup_file_with_sidecars(db, snap, db.name)
        except OSError as exc:
            return 0, [f"history db backup failed, projection left untouched: {exc}"]
    try:
        conn = sqlite3.connect(db)
    except sqlite3.Error as exc:
        return 0, [f"cannot open {db.name}: {exc}"]
    deleted = 0
    errors: list[str] = []
    try:
        present = {
            row[0]
            for row in conn.execute("SELECT name FROM sqlite_master WHERE type='table'")
        }
        conn.execute("BEGIN IMMEDIATE")
        for table in HISTORY_TABLES:
            if table not in present:
                continue
            for thread_id in sorted(thread_ids):
                cursor = conn.execute(
                    f"DELETE FROM {table} WHERE thread_id = ?", (thread_id,)
                )
                deleted += max(cursor.rowcount, 0)
        conn.commit()
    except sqlite3.Error as exc:
        conn.rollback()
        errors.append(f"history projection reset failed: {exc}")
    finally:
        conn.close()
    return deleted, errors


def all_rollout_paths() -> tuple[list[Path], str | None]:
    """All rollout files plus a warning when the state db could not be read.

    Returns (paths, db_warning): paths are sorted and deduplicated from both
    the active ``sessions`` tree, the ``archived_sessions`` tree, and the
    threads table; db_warning is set when the db is present but unreadable, so
    callers know the list may be incomplete.
    """
    paths: dict[Path, None] = {}
    db_warning: str | None = None
    for dirname in ("sessions", "archived_sessions"):
        root = codex_home() / dirname
        if root.is_dir():
            for path in root.rglob("rollout-*.jsonl"):
                paths[path] = None
    db = state_db_path()
    if db.exists():
        conn = connect_state_db_readonly(db)
        if conn is None:
            db_warning = (
                "state_5.sqlite 暂时无法读取，仅按 sessions 目录扫描；"
                "若结果不全，请完全退出 Codex（Cmd+Q）后重试。"
            )
        else:
            try:
                rows = conn.execute("SELECT rollout_path FROM threads").fetchall()
            finally:
                conn.close()
            for (raw,) in rows:
                if not raw:
                    continue
                path = Path(raw).expanduser()
                if path.is_file():
                    paths[path] = None
    return sorted(paths), db_warning


def resolve_rollout_paths(session: str) -> list[Path]:
    """Every rollout matching ``session`` (a session id or a file name).

    One session can own several rollout files: the initial one plus each
    continued rollout. They share the session id and all need the same repair,
    so every match is returned instead of failing on an ambiguous match.
    """
    candidates: list[Path] = []
    seen: set[Path] = set()

    def add(path: Path) -> None:
        if path.is_file() and path not in seen:
            candidates.append(path)
            seen.add(path)

    paths, _db_warning = all_rollout_paths()
    for path in paths:
        if session in path.name:
            add(path)
    db = state_db_path()
    if db.exists():
        conn = connect_state_db_readonly(db)
        if conn is not None:
            try:
                rows = conn.execute(
                    "SELECT id, rollout_path FROM threads WHERE id = ? OR rollout_path LIKE ?",
                    (session, f"%{session}%"),
                ).fetchall()
            finally:
                conn.close()
            for _tid, raw in rows:
                if raw:
                    add(Path(raw).expanduser())
    if not candidates:
        raise ValueError(
            f"No rollout file matches session id '{session}'. Pass the full "
            "session id (e.g. 019fcb99-1c6f-74c2-a5bb-f390a2013653) or a "
            "rollout filename."
        )
    return candidates


def scan_reasoning(path: Path) -> dict:
    """Inspect a rollout's reasoning items.

    Returns counters for the two things the official API rejects when history
    is replayed after a third-party provider switch:

    ``total``             reasoning items seen
    ``with_content``      plaintext ``content`` (the API wants an empty array)
    ``foreign_encrypted`` ``encrypted_content`` that is not an official blob
    """
    stats = {"total": 0, "with_content": 0, "foreign_encrypted": 0}
    try:
        raw = path.read_bytes()
    except OSError:
        return stats
    for part in raw.split(b"\n"):
        stripped = part.strip()
        if not stripped:
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            continue
        payload = obj.get("payload") if isinstance(obj, dict) else None
        if not isinstance(payload, dict) or payload.get("type") != REASONING_TYPE:
            continue
        stats["total"] += 1
        content = payload.get("content")
        if isinstance(content, list) and content:
            stats["with_content"] += 1
        if is_foreign_encrypted_content(payload.get("encrypted_content")):
            stats["foreign_encrypted"] += 1
    return stats


def reasoning_needs_repair(stats: dict) -> bool:
    return bool(stats["with_content"] or stats["foreign_encrypted"])


def rewrite_reasoning_items(path: Path, drop_foreign: bool = False) -> dict:
    """Make reasoning items replayable by the official API.

    * plaintext ``content`` becomes ``[]`` (the API requires an empty array)
    * ``encrypted_content`` that is not an official blob is removed (the API
      cannot verify a placeholder written by a third-party provider)

    Both keep every line at its original byte length by padding with spaces, so
    Codex's byte offsets stay valid. ``drop_foreign`` removes those reasoning
    lines entirely instead, which *does* shrink the file; the caller must then
    refresh the cached history projection.

    Returns counters: ``content_emptied``, ``encrypted_stripped``,
    ``lines_dropped`` and ``padding_bytes``.
    """
    raw = path.read_bytes()
    parts = raw.split(b"\n")
    out: list[bytes] = []
    result = {
        "content_emptied": 0,
        "encrypted_stripped": 0,
        "lines_dropped": 0,
        "padding_bytes": 0,
    }
    for part in parts:
        stripped = part.strip()
        if not stripped:
            out.append(part)
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            out.append(part)
            continue
        payload = obj.get("payload") if isinstance(obj, dict) else None
        if not isinstance(payload, dict) or payload.get("type") != REASONING_TYPE:
            out.append(part)
            continue
        content = payload.get("content")
        has_content = isinstance(content, list) and bool(content)
        foreign = is_foreign_encrypted_content(payload.get("encrypted_content"))
        if not has_content and not foreign:
            out.append(part)
            continue
        if drop_foreign and foreign:
            result["lines_dropped"] += 1
            continue
        carriage_return = b"\r" if part.endswith(b"\r") else b""
        body_limit = len(part) - len(carriage_return)
        if has_content:
            payload["content"] = []
            result["content_emptied"] += 1
        if foreign:
            payload.pop("encrypted_content", None)
            result["encrypted_stripped"] += 1
        body = json.dumps(obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
        out.append(pad_line(body, body_limit) + carriage_return)
        result["padding_bytes"] += body_limit - len(body)
    new_raw = b"\n".join(out)
    if not result["lines_dropped"] and len(new_raw) != len(raw):
        raise ValueError(
            f"{path.name}: refusing to write, byte length would change "
            f"({len(raw)} -> {len(new_raw)})"
        )
    if new_raw != raw:
        path.write_bytes(new_raw)
    return result


def backup_rollouts(paths: list[Path]) -> Path:
    """Copy rollout files (plus a sha256 manifest) into a repair-<ts> snapshot."""
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    snap = backup_dir() / f"repair-{stamp}"
    snap.mkdir(parents=True, exist_ok=True)
    manifest: dict[str, dict] = {}
    for path in paths:
        rel = path.relative_to(codex_home())
        target = snap / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
        manifest[str(path)] = {
            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
            "backup": str(target),
        }
    (snap / "manifest.json").write_text(
        json.dumps(manifest, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    return snap


def scan_all_rollouts() -> tuple[list[tuple[Path, dict]], str | None]:
    """Return (repair plan, db warning) across every rollout."""
    paths, db_warning = all_rollout_paths()
    plan = []
    for path in paths:
        stats = scan_reasoning(path)
        if reasoning_needs_repair(stats):
            plan.append((path, stats))
    return plan, db_warning


def apply_repairs(
    plan: list[tuple[Path, dict]],
    refresh_history: bool = True,
    drop_foreign: bool = False,
) -> dict:
    """Back up, repair, and re-project every rollout in ``plan``.

    Returns a summary dict with ``backup``, ``rollouts``, ``content_emptied``,
    ``encrypted_stripped``, ``lines_dropped``, ``padding_bytes`` and
    ``projection_rows_dropped``. Unless ``drop_foreign`` is set, every file is
    verified to keep its exact byte size before the cached history projection
    is refreshed.
    """
    snap = backup_rollouts([path for path, _ in plan])
    totals = {
        "content_emptied": 0,
        "encrypted_stripped": 0,
        "lines_dropped": 0,
        "padding_bytes": 0,
    }
    thread_ids: set[str] = set()
    for path, stats in plan:
        size_before = path.stat().st_size
        result = rewrite_reasoning_items(path, drop_foreign=drop_foreign)
        if result["content_emptied"] != stats["with_content"]:
            raise ValueError(
                f"{path.name}: expected {stats['with_content']} content fix(es), "
                f"applied {result['content_emptied']}"
            )
        expected_foreign = stats["foreign_encrypted"]
        handled_foreign = (
            result["lines_dropped"] if drop_foreign else result["encrypted_stripped"]
        )
        if handled_foreign != expected_foreign:
            raise ValueError(
                f"{path.name}: expected {expected_foreign} foreign encrypted "
                f"item(s), handled {handled_foreign}"
            )
        size_after = path.stat().st_size
        if not drop_foreign and size_after != size_before:
            raise ValueError(
                f"{path.name}: byte length changed ({size_before} -> {size_after}); "
                f"restore from {snap}"
            )
        for key, value in result.items():
            totals[key] += value
        thread_ids.update(rollout_thread_ids(path))
    dropped_rows = 0
    if refresh_history:
        dropped_rows, errors = refresh_history_projection(thread_ids, snap)
        for error in errors:
            print(f"WARNING: {error}", file=sys.stderr)
    return {
        "backup": snap,
        "rollouts": len(plan),
        "projection_rows_dropped": dropped_rows,
        **totals,
    }


def command_repair(args: argparse.Namespace) -> int:
    if args.all and args.session:
        print("Specify either a session id or --all, not both.", file=sys.stderr)
        return 2
    if not args.all and not args.session:
        print("Specify a session id or --all.", file=sys.stderr)
        return 2

    if args.drop_foreign_reasoning and args.no_refresh_history:
        print(
            "--drop-foreign-reasoning removes lines, so the cached history "
            "projection must be refreshed; drop --no-refresh-history.",
            file=sys.stderr,
        )
        return 2

    if args.all:
        plan, db_warning = scan_all_rollouts()
        if db_warning:
            print(f"WARNING: {db_warning}", file=sys.stderr)
        matched = len(all_rollout_paths()[0])
        print(f"Rollouts scanned: {matched}")
    else:
        try:
            paths = resolve_rollout_paths(args.session)
        except ValueError as exc:
            print(f"ERROR: {exc}", file=sys.stderr)
            return 1
        matched = len(paths)
        print(f"Rollouts matched for '{args.session}': {matched}")
        for path in paths:
            print(f"  {path.name}")
        plan = []
        for path in paths:
            stats = scan_reasoning(path)
            if reasoning_needs_repair(stats):
                plan.append((path, stats))

    print(f"Rollouts to repair: {len(plan)}")
    for path, stats in plan:
        print(
            f"  {path.name}: {stats['with_content']} reasoning item(s) with content "
            f"to empty, {stats['foreign_encrypted']} with a non-OpenAI "
            f"encrypted_content (of {stats['total']} reasoning item(s))"
        )

    if args.dry_run or not plan:
        if args.dry_run:
            print("Dry run: no files were changed.")
        else:
            print("Nothing to repair: every reasoning item already has empty content.")
        return 0

    if is_codex_running() and not args.force:
        print(
            "Codex desktop is still running.\n"
            "Fully quit Codex (Cmd+Q), then run: codex-api-switch repair "
            + ("--all" if args.all else args.session),
            file=sys.stderr,
        )
        return 3

    if not args.yes:
        answer = input(
            f"Rewrite {len(plan)} rollout(s) (empty reasoning content, remove "
            "non-OpenAI encrypted_content)? "
            "A backup is created first. [y/N] "
        ).strip().lower()
        if answer not in ("y", "yes"):
            print("Aborted.")
            return 0

    try:
        summary = apply_repairs(
            plan,
            refresh_history=not args.no_refresh_history,
            drop_foreign=args.drop_foreign_reasoning,
        )
    except Exception as exc:  # noqa: BLE001
        print(f"ERROR: repair failed: {exc}", file=sys.stderr)
        return 1

    print(f"Repaired {summary['rollouts']} rollout(s):")
    print(f"  reasoning content emptied        : {summary['content_emptied']}")
    print(f"  foreign encrypted_content removed: {summary['encrypted_stripped']}")
    if summary["lines_dropped"]:
        print(f"  reasoning lines dropped          : {summary['lines_dropped']}")
    if args.drop_foreign_reasoning:
        print(
            "Byte lengths changed because lines were dropped; the cached "
            "history projection was refreshed so Codex re-reads these files."
        )
    else:
        print(
            f"Byte lengths preserved: {summary['padding_bytes']} padding byte(s) "
            "added, file sizes unchanged"
        )
    if args.no_refresh_history:
        print("History projection refresh skipped (--no-refresh-history).")
    else:
        print(
            f"History projection refreshed: {summary['projection_rows_dropped']} "
            "cached row(s) dropped (Codex will re-read these rollouts)"
        )
    print(f"Backup: {summary['backup']}")
    left_content = sum(scan_reasoning(path)["with_content"] for path, _ in plan)
    left_encrypted = sum(scan_reasoning(path)["foreign_encrypted"] for path, _ in plan)
    if left_content or left_encrypted:
        print(
            f"WARNING: {left_content} reasoning item(s) still have content and "
            f"{left_encrypted} still carry a foreign encrypted_content",
            file=sys.stderr,
        )
        return 1
    return 0


